# Security headers for static hosts that honour a Netlify-style _headers file (Netlify, Cloudflare Pages).
# The app is a static bundle; it talks only to the GenLayer StudioNet RPC and the user's injected wallet.
# NOT verified on a live host (Stage 6): re-check the wallet connection and RPC calls after enabling.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://studio.genlayer.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
