# Canonical CLAUSE contract address (StudioNet). Leave UNSET until Stage 6 deploys the contract.
# The app renders an explicit "contract not configured" state when this is missing or invalid.
# VITE_CLAUSE_CONTRACT_ADDRESS=0x...
# Development-only (ignored/refused in production builds): point the app at a local GenLayer simulator.
# VITE_CLAUSE_NETWORK=localnet
